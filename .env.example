# App Configuration
PORT=3000
NODE_ENV=production

# OpenTelemetry Standard OTLP Ingestion Settings for OpenObserve
OTEL_SERVICE_NAME=proyecto-parcial2-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve.example.com:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic root@example.com:password_base64

# OpenObserve API Notification Configuration (Used by CI/CD Pipeline & App)
OPENOBSERVE_URL=http://openobserve.example.com:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=app_logs
OPENOBSERVE_AUTH_TOKEN=Basic root@example.com:password_base64

# Docker & EC2 Configuration (For GitHub Secrets reference)
DOCKER_HUB_USERNAME=your_dockerhub_username
DOCKER_IMAGE_NAME=proyecto-parcial2-app
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
EC2_USER=ubuntu
