{
  "name": "proyecto-parcial2-cicd-observability",
  "version": "1.0.0",
  "description": "Proyecto Parcial 2 - React, PostgreSQL, Auth, User CRUD, OpenTelemetry OTLP, Jest & Playwright",
  "main": "src/backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node --import ./src/backend/tracing.js src/backend/server.js",
    "start:direct": "node src/backend/server.js",
    "build": "vite build",
    "dev": "vite",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/jest.config.js",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/instrumentation-express": "^0.47.0",
    "@opentelemetry/instrumentation-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-logs": "^0.57.2",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.7"
  }
}
